# Development environment.
#
# Read by docker compose (environment/docker-compose.yml) through the Make
# targets in this folder:
#   make -C environment test ENV=dev
#
# Everything here is a build/test setting; T1K has no runtime configuration
# or credentials.

# Compose project name (portable replacement for the v2-only `name:` key).
COMPOSE_PROJECT_NAME=t1k-env

# Image tag for this environment. (compose only)
IMAGE_TAG=t1k-env:dev

# Root Makefile target the `test` service runs: the plain suite, cached by Go.
TEST_TARGET=test

# Flags applied to every go command inside the container (see `go help
# environment`). Empty: Go's defaults, with the build and test caches.
GOFLAGS=

# Host port the docs service publishes; the container listens on 8000.
DOCS_PORT=8000
