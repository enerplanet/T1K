# Test environment: what CI runs, in a container.
#
#   make -C environment check ENV=test   # tests with the race detector, then lint
#
# Same variables as .env.dev; see there for what each one does.

COMPOSE_PROJECT_NAME=t1k-env
IMAGE_TAG=t1k-env:test

# Race detector and shuffled test order, as in .github/workflows/ci.yml.
TEST_TARGET=test-race

# Bypass Go's test cache so every run really executes the tests.
GOFLAGS=-count=1

DOCS_PORT=8000
